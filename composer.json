{
    "name": "jovian/venusian-harfbuzz",
    "description": "HarfBuzz text shaper for Venusian Topside: text shaped into positioned glyphs by HarfBuzz through ext-harfbuzz.",
    "version": "0.11.0",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "topside",
        "typography",
        "harfbuzz"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-harfbuzz/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-harfbuzz/issues",
        "source": "https://github.com/jovian-packages/venusian-harfbuzz"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-harfbuzz": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Typography\\HarfBuzz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Typography\\HarfBuzz\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Typography\\HarfBuzz\\Providers\\VenusianHarfBuzzServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
